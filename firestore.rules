rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's profile and sessions are private to them.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Leagues are gated by knowing the unguessable 6-char code (the doc id).
    // No `list` rule anywhere, so leagues can't be enumerated.
    match /leagues/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      // Owner can edit anything. A non-owner may only add or remove their OWN uid
      // from memberUids (join/leave) — nothing else about the doc may change, and
      // they can't touch anyone else's membership or wipe the list.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerUid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) &&
          request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).hasOnly([request.auth.uid]) &&
          resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).hasOnly([request.auth.uid])
        )
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      // Leaderboard stats: any signed-in user can read a row (and read implies
      // list). The rules can't check that a caller knows the code, so this read
      // access rests entirely on the parent code being unguessable and unlistable,
      // not on rule enforcement. Each player can only write their own row.
      match /stats/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
